# PDF streams can be valid ASCII85 text. Keep them out of textual diffs and
# whitespace checks so contributors receive feedback about source files only.
*.pdf binary

# Manifest sha256 hashes are computed on checked-out bytes. Pin text files to
# LF so Windows checkouts cannot change content and break CI hash validation.
submissions/kuankqaq/zhilian-jingzhang/**/*.json text eol=lf
submissions/kuankqaq/zhilian-jingzhang/**/*.geojson text eol=lf
submissions/kuankqaq/zhilian-jingzhang/**/*.md text eol=lf
submissions/kuankqaq/zhilian-jingzhang/**/*.html text eol=lf
