    "observed_findings": [
      "2025 WorldPop modelled population is 192592.43 within the provisional research boundary.",
      "17.9% of modelled population has at least one measured education/health/daily-service gap; 4.4% has two or more.",
      "Five-date 2026 summer Sentinel-2 composite gives 26.23% vegetation spectral cover proxy and 7.12% dense-vegetation proxy across the provisional site.",
      "Official Haidian directories conservatively validate 36 school, 2 medical and 1 eldercare site OSM points; this is a cross-check subset, not a full replacement registry.",
      "The promoted 8+4 consensus node geometry still covers 57.6% of modelled population, 61.9% of gap1 and 51.5% of gap2 population after v0.4 re-audit.",
      "A full v0.4 multi-objective node re-optimization improves opportunity-population mean by 0.009139 but reduces population coverage by 0.005026 and gap1 coverage by 0.004411, with gap2 unchanged; the current four formal consensus replacements are therefore retained as the better balanced scheme.",
      "CORRIDOR-04 remains rank-1 after adding explicit Sentinel green deficit, with top20 robustness probability 0.9986 and top10 probability 0.986."
    ],
    "design_responses": [
      "Retain eight audited V1 service-node centers and materialize PUBLIC-V2-01..04 as four multi-objective consensus replacement concept sites; tenure, official-facility, utility, fire/accessibility and field-survey conflicts remain explicit re-selection triggers.",
      "Use CORRIDOR-04 as the lead Dazhongsi connection demonstrator with CORRIDOR-03/05 as alignment tolerance.",
      "Prioritize station-city permeability and service completion in Dazhongsi; refine the AI Origin Community around shared-ground-floor innovation/life support; rebalance Zhongzhiyuan testing functions with everyday services."
    ],
    "expected_impact_status": "scenario_modelled_or_design_target_only",
    "unresolved_evidence": [
      "Formal redlines, tenure, utilities, rail safety, accessibility/fire constraints and field survey remain pending.",
      "Official-facility validation is partial by design; unmatched records are not force-geocoded."
    ]
  },
