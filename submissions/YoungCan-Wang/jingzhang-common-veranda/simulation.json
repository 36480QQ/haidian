{
  "version": 1,
  "title": "Veranda Receipt / 门廊回执 90-day tabletop",
  "status": "tabletop_only_not_authorized_not_run",
  "proof_boundary": {
    "proves": [
      "the seven-gate decision sequence is machine-readable",
      "four stop branches and one positive control produce expected decisions",
      "a five-step rollback record is structurally complete"
    ],
    "does_not_prove": [
      "site permission, safety, accessibility or engineering feasibility",
      "real service quality, response time, public acceptance or model performance",
      "government, campus, enterprise or community endorsement"
    ]
  },
  "pilot_contract": {
    "pilot_id": "VR-AIO-90D-001",
    "place": "AI Origin Learning Veranda provisional public interface",
    "purpose": "Test whether a public learning request can move from question to an attributable, reversible evidence receipt without collecting personal data.",
    "real_world_run": false,
    "authorization_status": "not_requested_not_granted",
    "data_rule": "synthetic fixtures only; no personal, biometric, minor or live operational data",
    "non_ai_equivalent": "staffed paper request card, printed source list and in-person explanation desk",
    "stages": [
      {
        "days": "0-30",
        "name": "LOCK",
        "deliverable": "scope, site interface, data, rights and responsible roles locked"
      },
      {
        "days": "31-60",
        "name": "MOCK",
        "deliverable": "offline passive prototype and public-notice mock-up"
      },
      {
        "days": "61-75",
        "name": "RED TEAM",
        "deliverable": "negative fixtures, stop branches and rollback rehearsal"
      },
      {
        "days": "76-90",
        "name": "DECIDE",
        "deliverable": "adopt, revise or retire recommendation; no automatic launch"
      }
    ],
    "gates": [
      {
        "id": "G0",
        "name": "Mandate",
        "pass": "tabletop scope signed; real_world_run=false",
        "stop": "scope or authority is ambiguous"
      },
      {
        "id": "G1",
        "name": "Place and access",
        "pass": "provisional interface and emergency/access checklist recorded",
        "stop": "route or egress evidence missing"
      },
      {
        "id": "G2",
        "name": "Minimum data",
        "pass": "synthetic_data=true and personal_data=false",
        "stop": "personal, biometric, minor or live data appears"
      },
      {
        "id": "G3",
        "name": "Rights and provenance",
        "pass": "source licence and reuse limits recorded",
        "stop": "rights or provenance unresolved"
      },
      {
        "id": "G4",
        "name": "Human control",
        "pass": "steward role and manual takeover rehearsal recorded",
        "stop": "responsible steward or takeover missing"
      },
      {
        "id": "G5",
        "name": "Public notice",
        "pass": "purpose, data, owner, status, non-AI route and appeal are visible",
        "stop": "notice or equivalent service missing"
      },
      {
        "id": "G6",
        "name": "Receipt and exit",
        "pass": "evidence receipt complete; five rollback steps and exit available",
        "stop": "receipt, appeal, exit or rollback incomplete"
      }
    ],
    "raci": [
      {
        "role": "pilot sponsor",
        "accountability": "authorizes scope and accepts retirement decision",
        "current_assignment": "unassigned until a real host opts in"
      },
      {
        "role": "site steward",
        "accountability": "access, notice, manual takeover and incident log",
        "current_assignment": "unassigned"
      },
      {
        "role": "data/IP reviewer",
        "accountability": "minimum-data and provenance gate",
        "current_assignment": "unassigned"
      },
      {
        "role": "accessibility co-reviewer",
        "accountability": "route and non-AI-equivalent review",
        "current_assignment": "unassigned"
      },
      {
        "role": "public observer",
        "accountability": "witnesses stop/rollback rehearsal and publishes dissent",
        "current_assignment": "unassigned"
      }
    ],
    "rollback": [
      "freeze new requests and show PAUSED state",
      "route every open request to the staffed non-AI path",
      "isolate the removable smart layer and retain only minimum incident evidence",
      "notify steward, sponsor and affected participants; open appeal window",
      "publish repair-or-retire receipt and remove the prototype if gates remain unmet"
    ]
  },
  "tasks": [
    {
      "task_id": "P01-positive-control",
      "outcome": "success",
