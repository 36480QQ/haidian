{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "inclusion-ledger.schema.json",
  "title": "Population inclusion incidence ledger contract",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "proposal_sections",
    "recalculation_key",
    "population_group_count",
    "population_groups",
    "aggregation_rule",
    "known_limitations"
  ],
  "properties": {
    "$schema": {
      "const": "inclusion-ledger.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "proposal_sections": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "recalculation_key": {
      "const": [
        "group_id",
        "intervention_id",
        "geometry_version",
        "evidence_cutoff"
      ]
    },
    "population_group_count": {
      "const": 9
    },
    "population_groups": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/definitions/population_group"
      },
      "allOf": [
        {"contains": {"type": "object", "properties": {"group_id": {"const": "resident_long_term"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "tenant"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "older_adult"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "child_youth"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "mobility_impaired"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "low_income_informal_work"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "young_talent"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "enterprise_university"}}, "required": ["group_id"]}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "visitor"}}, "required": ["group_id"]}}
      ]
    },
    "aggregation_rule": {
      "const": "人群维度不做净额相抵；总体受益不能取消任何人群的权利、法定程序、最低服务条件或未解决的代价。"
    },
    "known_limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 12
      }
    }
  },
  "definitions": {
    "population_group": {
      "type": "object",
      "required": [
        "group_id",
        "label_zh",
        "label_en",
        "definition",
        "benefit_status",
        "benefit_items",
        "cost_status",
        "cost_items",
        "blind_spot_status",
        "blind_spots",
        "verifiable_intermediates",
        "required_inputs",
        "procedural_standing"
      ],
      "properties": {
        "group_id": {
          "enum": [
            "resident_long_term",
            "tenant",
            "older_adult",
            "child_youth",
            "mobility_impaired",
            "low_income_informal_work",
            "young_talent",
            "enterprise_university",
            "visitor"
          ]
        },
        "label_zh": {
          "type": "string",
          "minLength": 2
        },
        "label_en": {
          "type": "string",
          "minLength": 4
        },
        "definition": {
          "type": "string",
          "minLength": 30
        },
        "benefit_status": {
          "const": "qualitative_reference_only"
        },
        "benefit_items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "公共通行",
              "日常停留",
              "服务可达",
              "社区与学研之间的资源共享"
            ]
          }
        },
        "cost_status": {
          "const": "qualitative_reference_only"
        },
        "cost_items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "施工",
              "绕行",
              "噪声",
              "经营",
              "维护",
              "能源",
              "隐私",
              "空间排他",
              "affected_household_count",
              "mitigation_budget_cny",
              "duty_closure_ratio"
            ]
          }
        },
        "blind_spot_status": {
          "const": "unknown"
        },
        "blind_spots": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/blind_spot"
          }
        },
        "verifiable_intermediates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/verifiable_intermediate"
          }
        },
        "required_inputs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "procedural_standing": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/definitions/procedural_standing"}
          ]
        }
      },
      "additionalProperties": false
    },
    "blind_spot": {
      "type": "object",
      "required": [
        "status",
        "statement",
        "statement_en"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "statement_en": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "verifiable_intermediate": {
      "type": "object",
      "required": [
        "intermediate_id",
        "name_zh",
        "name_en",
        "status",
        "value",
        "unit",
        "formula",
        "source_refs"
      ],
      "properties": {
        "intermediate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 4
        },
        "name_en": {
          "type": "string",
          "minLength": 8
        },
        "status": {
          "const": "unknown"
        },
        "value": {
          "type": "null"
        },
        "unit": {
          "enum": [
            "count",
            "m",
            "sqm"
          ]
        },
        "formula": {
          "type": "string",
          "minLength": 20
        },
        "source_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      },
      "additionalProperties": false
    },
    "procedural_standing": {
      "type": "object",
      "required": [
        "status",
        "mechanisms"
      ],
      "properties": {
        "status": {
          "const": "proposed_not_existing"
        },
        "mechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "mechanism_ref",
              "standing"
            ],
            "properties": {
              "mechanism_ref": {
                "enum": [
                  "gates/01",
                  "gates/02",
                  "gates/03",
                  "reversibility-r1-r3"
                ]
              },
              "standing": {
                "type": "string",
                "minLength": 15
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
