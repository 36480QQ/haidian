      },
      {
        "id": "DR-09",
        "record": "Site-use or test permission",
        "provider": "authorised_site_manager",
        "required_metadata": [
          "place",
          "time",
          "footprint",
          "activity",
          "removal_conditions"
        ],
        "if_missing": "HOLD exercise."
      },
      {
        "id": "DR-10",
        "record": "Named operating and stop authority",
        "provider": "implementing_and_operating_parties",
        "required_metadata": [
          "person",
          "organisation",
          "service_hours",
          "stop_authority"
        ],
        "if_missing": "HOLD human-service claim and relevant exercise."
      },
      {
        "id": "DR-11",
        "record": "Funding procurement or resource path",
        "provider": "authorised_funding_or_procurement_party",
        "required_metadata": [
          "budget_or_resource_path",
          "custody",
          "insurance"
        ],
        "if_missing": "Do not claim funded delivery or procurement readiness."
      },
      {
        "id": "DR-12",
        "record": "Data and compute governance record",
        "provider": "authorised_data_controller_or_service_owner",
        "required_metadata": [
          "source",
          "purpose",
          "minimisation",
          "retention",
          "audit",
          "appeal"
        ],
        "if_missing": "HOLD real-data or AI-enabled activity."
      }
    ]
  },
