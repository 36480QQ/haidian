{
  "schema_version": "1.0.0",
  "artifact_type": "phase0_activation_evidence_register",
  "status": "conceptual_pre_activation_template",
  "purpose": "Provide one machine-readable, editable register for future authorised parties to request data, record field observations, control a bounded exercise, and return to baseline without asserting present implementation capability.",
  "claim_boundary": "This register appoints no organisation and records no received official data, permission, budget, procurement, land right, site access, operating commitment, service agreement, approval, field condition, or Verified SLA upgrade. Every blank, missing, expired, contradictory, or unauditable record remains HOLD. AI cannot convert unknown to Verified.",
  "operating_sequence": [
    "Request only public or cleared records with a version, date, coordinate reference system where relevant, permitted reuse scope, and evidence owner.",
    "Assign a named responsible party before an exercise; an unnamed concept role is not an operating role.",
    "Record the applicable field tasks with the required evidence fields and use each record only for the gate it supports.",
    "Run at most one authorised, bounded and reversible exercise after every applicable gate is affirmative.",
    "Stop, remove, reroute, downgrade, and return to baseline when any condition fails; archive the close-out record before a later decision."
  ],
  "data_request_register": {
    "default_status": "NOT_REQUESTED",
    "items": [
