  "activation_gates": [
    {
      "id": "GATE-01",
      "question": "Is the exact exercise location authorised and spatially identified?",
      "affirmative_evidence": "official_or_site_manager_cleared_location_record"
    },
    {
      "id": "GATE-02",
      "question": "Is a lawful public approach and clearway verified?",
      "affirmative_evidence": "completed_FV-01_to_FV-12"
    },
    {
      "id": "GATE-03",
      "question": "Is a continuous accessible alternative verified?",
      "affirmative_evidence": "completed_FV-13_to_FV-20"
    },
    {
      "id": "GATE-04",
      "question": "Are weather, drainage, lighting, and facilities checked for the exercise conditions?",
      "affirmative_evidence": "completed_FV-21_to_FV-35"
    },
    {
      "id": "GATE-05",
      "question": "Are named lead, handover, stop, and removal roles active for the stated period?",
      "affirmative_evidence": "completed_FV-36_to_FV-42"
    },
    {
      "id": "GATE-06",
      "question": "Is site-use permission valid for time, footprint, activity, and removal?",
      "affirmative_evidence": "written_permission_with_expiry_and_conditions"
    },
    {
      "id": "GATE-07",
      "question": "Are heritage, traffic, fire, municipal, and engineering interfaces cleared or explicitly outside scope?",
      "affirmative_evidence": "applicable_professional_records"
    },
    {
      "id": "GATE-08",
      "question": "Is the funding, procurement, insurance, and custody path confirmed if physical items are used?",
      "affirmative_evidence": "authorised_resource_record"
    },
    {
      "id": "GATE-09",
      "question": "If data or AI is used, are governance, minimisation, audit, and human-stop records complete?",
      "affirmative_evidence": "completed_FV-43_to_FV-45"
    },
    {
      "id": "GATE-10",
      "question": "Is a bounded exercise run sheet and close-out plan completed?",
      "affirmative_evidence": "activation_record_sections_3_and_5"
