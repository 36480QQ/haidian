      "evidence": "anonymous incident token and correction record",
      "owner": "ordinary_service_operator"
    },
    {
      "event": "accessibility_or_language_barrier",
      "immediate_action": "move to accessible staffed route and stop the affected proof",
      "evidence": "barrier observation without case content",
      "owner": "community_witness"
    },
    {
      "event": "handoff_target_missed",
      "immediate_action": "ordinary operator assumes control and marks target failed",
      "evidence": "timestamp pair and receipt state",
      "owner": "ordinary_service_operator"
    },
    {
      "event": "rollback_or_stop_failure",
      "immediate_action": "physical isolation, retire AI layer, keep ordinary service open",
      "evidence": "stop-control test and retirement record",
      "owner": "steward"
    },
    {
      "event": "privacy_or_security_incident",
      "immediate_action": "disconnect workstation, preserve only authorized audit evidence, escalate under future operator policy",
      "evidence": "incident classification and authorized disposition",
      "owner": "steward"
    }
