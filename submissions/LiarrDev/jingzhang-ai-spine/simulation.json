      "assertions": [
        { "id": "project_count", "check": "更新项目数量正确", "expected": 10, "actual": 10 },
        { "id": "phasing_assigned", "check": "每个项目均分配了分期（近期/中期/远期）", "expected": true, "actual": true },
        { "id": "dependency_listed", "check": "每个项目均列出了主要依赖", "expected": true, "actual": true },
