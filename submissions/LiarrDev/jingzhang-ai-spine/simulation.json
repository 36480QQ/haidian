      "expected_detection": "intercepted",
      "detected_by": "可验证试点路径表中JZ-01可撤回条件列（设施可撤回，不影响机动车通行）",
      "result": "pass"
    },
    {
      "id": "MUT-04",
      "assertion_type": "data_disposal_or_exit_verified",
