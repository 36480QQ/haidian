{
  "version": 2,
  "summary": "智脊·京张AI创新带的任务审计模拟，验证场景卡、用户画像、地标、全球案例、更新项目、风险矩阵、空间概念和指标的可审计性与一致性。包含变异测试（mutation testing）：故意注入违规，验证方案的人工复核、硬停止、可撤回和数据边界机制能够拦截。",
  "boundary_statement": "本模拟是离线概念验证。证明：判定逻辑可复现、高风险维度强制人工复核、AI场景无全自动决策、试点可撤回条件存在、数据边界不采集个人画像。不证明：实地读数、真实复核主体已介入、服务绩效、官方审批结论。变异测试的'拦截'指方案机制在文档层面识别并拒绝违规，不构成对真实系统安全性的承诺。",
  "tasks": [
    {
      "id": "SIM-S01",
      "task_type": "scenario_validation",
      "assertion_type": "human_review_enforced",
      "description": "验证开源发布厅(S01)场景的运营主体和数据边界是否在proposal.md中可追溯",
      "assertions": [
        { "id": "scenario_defined", "check": "proposal.md中存在S01场景卡条目", "expected": true, "actual": true },
        { "id": "operator_named", "check": "场景卡指明了运营主体", "expected": "开源社区运营", "actual": "开源社区运营" },
        { "id": "privacy_boundary_stated", "check": "场景卡标注了隐私边界", "expected": true, "actual": true },
        { "id": "human_review_present", "check": "审计表中该场景有人工复核节点", "expected": true, "actual": true }
      ],
      "result": "pass"
    },
    {
      "id": "SIM-S02",
      "task_type": "scenario_validation",
      "assertion_type": "human_review_enforced",
