      "assertions": [
        { "id": "scenario_defined", "check": "proposal.md中存在S10场景卡条目", "expected": true, "actual": true },
        { "id": "operator_named", "check": "场景卡指明了运营主体", "expected": "活动组委会", "actual": "活动组委会" },
        { "id": "safety_review", "check": "安全审查节点存在", "expected": true, "actual": true }
