  "mutation_tests": [
    {
      "id": "MUT-01",
      "assertion_type": "human_review_enforced",
      "mutation": "故意移除安全治理沙盒(S02)的人工复核节点，使其成为全自动红队测试场景",
      "injected_violation": "scenario_missing_human_review",
      "expected_detection": "intercepted",
      "detected_by": "AI场景数据-治理审计表中S02人工复核列（评测机构+园区联合审查）+ 自动化级别=辅助",
      "result": "pass"
    },
    {
      "id": "MUT-02",
      "assertion_type": "hard_stop_triggered_correctly",
      "mutation": "将政策不确定性风险评分从4降为2，从而移除其人工复核要求",
      "injected_violation": "high_risk_downgraded_without_review",
      "expected_detection": "intercepted",
      "detected_by": "risk.json中policy_uncertainty评分保持4并含human_review；summary中明确其为最需人工复核的两类风险之一",
      "result": "pass"
    },
    {
      "id": "MUT-03",
