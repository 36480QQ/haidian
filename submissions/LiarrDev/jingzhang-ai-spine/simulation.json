      "assertions": [
        { "id": "scenario_defined", "check": "proposal.md中存在S03场景卡条目", "expected": true, "actual": true },
        { "id": "operator_named", "check": "场景卡指明了运营主体", "expected": "运营商+政府", "actual": "运营商+政府" },
        { "id": "no_user_compute_collection", "check": "不采集用户计算行为声明存在", "expected": true, "actual": true }
