      ],
      "result": "pass"
    },
    {
      "id": "SIM-RISK-01",
      "task_type": "risk_validation",
      "assertion_type": "hard_stop_triggered_correctly",
      "description": "验证risk.json中8个风险维度均有评分、缓解措施和高风险维度的人工复核",
      "assertions": [
        { "id": "dimension_count", "check": "风险维度数量为8", "expected": 8, "actual": 8 },
        { "id": "high_risk_review", "check": "评分≥4的维度均有人工复核要求", "expected": true, "actual": true },
        { "id": "mitigation_all", "check": "每个维度均有缓解措施", "expected": true, "actual": true },
