{
  "schema_version": "0.1.0",
  "prototype_id": "JZ-QH-NON-AI-CIVIC-HANDOFF",
  "name_zh": "清河站非 AI 公共服务接力接口",
  "name_en": "Qinghe Non-AI Civic Service Handoff",
  "status": "concept_nts_pending_site_and_operator_verification",
  "site_scope": {
    "description_zh": "清河站西广场、既有地下慢行系统与 B1 城市通廊之间的公众功能关系，止于付费区与安检区之外的人工接力边界。",
    "description_en": "Public functional relationship among Qinghe west square, the existing underground walking system and the B1 city corridor, ending at a human handoff outside fare and security control.",
    "geometry_mode": "concept",
    "drawing_status": "NTS_non_survey_non_implementation",
    "exact_entrance": "unknown",
    "exact_route": "unknown",
    "dimensions": "unknown",
    "ownership": "unknown",
    "opening_state": "verify_at_time_of_service"
  },
  "ordinary_task": {
    "user_zh": "首次到访且没有或选择不使用智能手机的人",
    "user_en": "A first-time visitor without, or choosing not to use, a smartphone",
    "need_zh": "取得前往 13 号线无台阶换乘的人工说明与接力",
    "need_en": "Obtain a human explanation and handoff for a step-free transfer to Line 13",
    "completion_rule": "human_takeover_or_explicit_current_unavailability"
  },
  "non_ai_path": [
    {"id": "N0", "action": "read_fixed_non_electronic_overview"},
    {"id": "N1", "action": "enter_existing_underground_walking_system"},
    {"id": "N2", "action": "tell_visible_human_line_13_and_step_free_need"},
    {"id": "N3", "action": "receive_current_staff_marked_paper_route_card"},
    {"id": "N4", "action": "follow_existing_signs_and_staff_confirmed_lift"},
    {"id": "N5", "action": "existing_station_security_or_rail_staff_take_over"}
  ],
  "failure_branches": [
    {"id": "F1", "trigger": "network_or_ai_off", "rule": "ordinary_path_unchanged"},
    {"id": "F2", "trigger": "lift_unavailable", "rule": "state_break_and_use_only_staff_confirmed_alternative_otherwise_stop"},
    {"id": "F3", "trigger": "b1_unavailable", "rule": "stop_descent_at_ground_and_point_to_visible_on_duty_human"}
  ],
  "reversible_components": [
    {"id": "QH-C01", "name_zh": "固定非电子总览", "name_en": "fixed non-electronic overview", "personal_data": "none"},
    {"id": "QH-C02", "name_zh": "纸质路径卡", "name_en": "paper route card", "personal_data": "none"},
    {"id": "QH-C03", "name_zh": "人工接力标记", "name_en": "human-handoff marker", "personal_data": "none"}
  ],
  "optional_ai": {
    "allowed": ["translation", "read_aloud", "dynamic_prompt"],
    "prohibited": ["confirm_lift_state", "invent_route", "replace_human_handoff", "require_account_or_scan"]
  },
  "evidence_sources": [
    "QH-STATION-MAP-2026",
    "QH-UNDERGROUND-WALK-2026",
    "QH-STATION-FLOORS-2019",
    "QH-B1-SERVICE-HALL-2024",
    "QH-ACCESS-AUDIT-2025",
    "QH-HUMAN-HANDOFF-2026"
  ],
  "assumption_links": [
