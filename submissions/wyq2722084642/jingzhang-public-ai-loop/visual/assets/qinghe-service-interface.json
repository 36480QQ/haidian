    "A-QH-STAFF-010",
    "A-QH-BOUNDARY-011",
    "A-QH-SCALE-012"
  ],
  "excluded_claims": [
    "underground_exact_route",
    "survey_scale_or_dimensions",
    "ownership_or_title",
    "utilities",
    "fire_or_egress_compliance",
    "civil_defence",
