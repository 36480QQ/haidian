{
  "schema_version": "0.2.0",
  "status": "suggested_pilot_protocol_not_statutory_standard",
  "raci": {
    "accountable": ["programme governance group: scope, budget, exit"],
    "responsible": ["urban design and engineering", "accessibility", "data and safety", "operations"],
    "consulted": ["resident representatives", "site rights holders", "transport/heritage/fire specialists", "procurement auditor"],
    "informed": ["public: scope, risk, result, retirement state"],
    "separation_of_duties": "One technology vendor cannot execute, accept and adjudicate the same test."
  },
  "cost_classes": {
    "C1": "research, walkthrough, governance or audit service",
    "C2": "movable prototype, content or modular light works",
    "C3": "sustained service network or high-safety controlled test",
    "disclaimer": "Comparative concept classes only; no investment amount or procurement threshold."
  },
  "packages": [
    {"id": "P1", "class": "C1", "start": ["survey scope", "sampling strategy", "privacy notice"], "cadence": "six-month review"},
    {"id": "P2", "class": "C2", "start": ["multidisciplinary review", "mock-up", "maintenance list"], "cadence": "monthly inspection"},
    {"id": "P3", "class": "C2-C3", "start": ["ethics/safety plan", "test script", "emergency-stop drill"], "cadence": "review every test"},
    {"id": "P4", "class": "C3", "start": ["service catalogue", "roster", "SLA", "training", "spares"], "cadence": "quarterly review"},
    {"id": "P5", "class": "C2", "start": ["history and rights review", "prototype co-test"], "cadence": "annual update"},
    {"id": "P6", "class": "C1", "start": ["RACI", "log fields", "appeal", "retirement template"], "cadence": "annual public report"}
  ],
  "test_gates": [
    {"test": "robot_yielding", "suggested_thresholds": ["zero major injury/collision events", "physical emergency stop checked before every shift", "local stop-chain instrument target <=1 second"], "takeover": "visible safety steward", "exit": "any major event stops the test; independent review before restart"},
    {"test": "public_ai_interoperability", "suggested_thresholds": [">=95% predefined account-free handoff pass rate", "no raw identity field crosses vendors"], "takeover": "human relay acknowledges within 60 seconds", "exit": "two failed rounds or non-exportable lock-in"},
    {"test": "offline_degraded_mode", "suggested_thresholds": ["100% L0 lighting/wayfinding/help/movement", "offline notice within 5 minutes"], "takeover": "patrol and paper log immediately", "exit": "L1/L2 cannot restart if basic service failed"},
    {"test": "accessible_information", "suggested_thresholds": [">=90% independent critical-task completion", "100% human alternative", "zero unresolved critical barriers"], "takeover": "human help responds within 60 seconds", "exit": "user veto until same-task retest passes"}
  ],
  "sla": {"information_acknowledgement_seconds": 60, "device_failure": "isolate and mark immediately", "routine_maintenance_plan_hours": 24},
  "quarterly_review": ["scope", "user burden", "energy and compute", "maintenance labour", "vendor lock-in", "open incidents"],
  "procurement_audit": ["open interface", "data portability", "maintenance right", "exit cost", "L0 independent acceptance", "subcontract and conflict sampling"]
}
