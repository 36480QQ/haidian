{
  "schema_version": "0.1.0",
  "protocol_id": "qi-protocol-v0.1",
  "package_id": "jingzhang-fengshui-ai-belt",
    "updated_at": "2026-08-26",
  "name_zh": "气数协议 v0.1（察气—演气—验气—养气）",
  "name_en": "Qi-as-Data Protocol v0.1 (observe — model — verify — maintain)",
  "purpose_zh": "把「气数（Qi-as-Data）」从概念锻造为可执行的治理协议：走廊上任何数据驱动的场景、指标或主张，都必须走过四步流程并遵守七条规则；说不出何时不成立的机制不是机制。",
  "purpose_en": "Forge Qi-as-Data from concept into an executable governance protocol: any data-driven scenario, metric, or claim on the corridor must pass the four steps and obey the seven rules; a mechanism that cannot state when it fails is not yet a mechanism.",
  "steps": [
    {
      "step": 1,
      "name_zh": "察气（Observe）",
      "definition_zh": "感知与登记：任何新增数据项先登记于对应场景卡的「最小数据与边界」列，注明聚合层级与匿名边界，方可启用。",
      "mandatory_artifacts_zh": [
        "场景卡最小数据列",
        "数据项登记记录"
      ],
      "fail_behavior_zh": "未登记即采集 → 数据即刻停用并公示。"
    },
    {
      "step": 2,
      "name_zh": "演气（Model）",
      "definition_zh": "演算与声明：代理模型/指数的输出必须标注「演算估计」，声明模型与版本；不得作为个体级决定的唯一依据。",
      "mandatory_artifacts_zh": [
        "模型与版本声明",
        "输出标注"
      ],
      "fail_behavior_zh": "未声明模型 → 输出不得对公众展示。"
    },
    {
      "step": 3,
      "name_zh": "验气（Verify）",
      "definition_zh": "复核与双通道：场景开放/停用/数据扩围须经独立复核者（R-INDEPENDENT-REVIEW）会签；无 AI 通道经无障碍守护者（R-ACCESS-GUARDIAN）验收；可复算数字以包内几何复算为准。",
      "mandatory_artifacts_zh": [
        "复核会签记录",
        "无AI通道验收记录",
        "复算脚本输出"
      ],
      "fail_behavior_zh": "缺任一会签/验收 → 场景不开放。"
    },
    {
      "step": 4,
      "name_zh": "养气（Maintain）",
      "definition_zh": "养护与退出：按节气节奏做季度复核与「开放-复核-退出/续期」演练；场景退出必须落在其「退出后空间用途」列声明的公共资产上。",
      "mandatory_artifacts_zh": [
        "季度复核简报",
        "退出复盘记录"
      ],
      "fail_behavior_zh": "无法落到公共资产 → 场景不予立项。"
    }
  ],
  "rules": [
    {
      "rule_id": "QP-1",
      "text_zh": "感知登记：新增数据项未登记于场景卡最小数据列，不得启用。"
    },
    {
      "rule_id": "QP-2",
      "text_zh": "匿名下限：个体级数据不得离开采集点，公共层只见聚合。"
    },
    {
      "rule_id": "QP-3",
      "text_zh": "模型声明：代理模型输出必须标注演算估计，不作个体决定唯一依据。"
    },
    {
      "rule_id": "QP-4",
      "text_zh": "双通道：场景开放前，无 AI 通道须经无障碍守护者验收。"
    },
    {
      "rule_id": "QP-5",
      "text_zh": "复核会签：场景开放/停用/数据扩围须经独立复核者会签。"
    },
    {
      "rule_id": "QP-6",
      "text_zh": "可复算优先：凡可由包内几何复算的数字，以复算为准，不以叙事口径替代。"
    },
    {
      "rule_id": "QP-7",
      "text_zh": "退出留城：场景退出必须落在声明的公共资产（退出后空间用途）上。"
    }
  ],
  "status_note_zh": "本协议为概念治理建议（v0.1），非政府审批流程；正式实施前由专业团队与主管部门校核。",
  "revision_mechanism": {
    "status_zh": "若协议进入试点应用，则启用本机制",
    "status_en": "This mechanism activates only if the protocol enters pilot application",
    "proposer_types_zh": ["社区代表", "任一运营岗", "参测机构", "专业机构"],
    "proposer_types_en": ["community representatives", "any operating role", "participating institutions", "professional institutions"],
    "required_submission_fields_zh": ["变更理由", "影响范围", "回滚方式", "与 QP-1 至 QP-7 的关系"],
    "required_submission_fields_en": ["reason for change", "impact scope", "rollback path", "relationship with QP-1 through QP-7"],
    "joint_review_chair_role_id": "R-INDEPENDENT-REVIEW",
    "joint_review_participant_roles_or_groups_zh": ["无障碍守护者", "数据治理相关岗", "受影响社区代表"],
    "joint_review_participant_roles_or_groups_en": ["accessibility guardian", "data-governance roles", "affected community representatives"],
    "model_output_condition_zh": "涉及模型输出的提案另须专业机构复核",
    "model_output_condition_en": "Proposals involving model output also require professional-institution review",
    "non_weakening_invariants_zh": ["察气—演气—验气—养气四步闭环", "无 AI 通道", "退出公共资产要求"],
    "non_weakening_invariants_en": ["four-step observe—model—verify—maintain loop", "no-AI paths", "exit-to-public-asset requirement"],
    "archive_rule_zh": "v0.1 及后续历史版本连同会审记录留存于治理档案",
    "archive_rule_en": "v0.1 and all later historical versions remain in the governance archive with joint-review records",
    "approval_deadline_commitment": false
  },
