{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rights-inventory.schema.json",
  "title": "Per-asset rights inventory",
  "description": "校验 manifest.json 的 rights_inventory 块：每一类资产必须同时给出权利人、生成方法、许可文本位置、第三方成分与核验方式；作者自有内容与第三方开源组件必须分开授权。",
  "type": "object",
  "required": [
    "notice_zh",
    "notice_en",
    "assets",
    "hash_coverage"
  ],
  "additionalProperties": false,
  "properties": {
    "notice_zh": {
      "type": "string",
      "minLength": 40
    },
    "notice_en": {
      "type": "string",
      "minLength": 40
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_class",
          "label_zh",
          "count",
          "rights_holder",
          "production_method_zh",
          "licence_text_location",
          "third_party_content_zh",
          "verification_zh"
        ],
        "additionalProperties": false,
        "properties": {
          "asset_class": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label_zh": {
            "type": "string",
            "minLength": 2
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "rights_holder": {
            "enum": [
              "package_participants",
              "Google_Adobe_Noto_contributors"
            ]
          },
          "production_method_zh": {
            "type": "string",
            "minLength": 6
          },
          "licence_text_location": {
            "type": "string",
            "pattern": "^(manifest\\.json#license\\.|visual/assets/governance/noto-cjk-subset\\.rights\\.json#license\\.text$)"
          },
          "licence": {
            "enum": [
              "OFL-1.1"
            ]
          },
          "third_party_content_zh": {
            "type": "string",
            "minLength": 1
          },
          "verification_zh": {
            "type": "string",
            "minLength": 6
          }
        }
      }
    },
    "hash_coverage": {
      "type": "object",
      "required": [
        "files_declared",
        "files_with_sha256",
        "note_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "files_declared": {
          "type": "integer",
          "minimum": 1
        },
        "files_with_sha256": {
          "type": "integer",
          "minimum": 1
        },
        "note_zh": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
