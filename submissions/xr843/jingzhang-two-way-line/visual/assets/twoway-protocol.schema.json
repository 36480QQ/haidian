{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-city-ai/haidian/submissions/xr843/jingzhang-two-way-line/visual/assets/twoway-protocol.schema.json",
  "title": "对开协议·班次凭证 / Two-Way Protocol Service Receipt",
  "description": "「对开协议」把每一次 AI 场景部署表述为一对班次：上行采集什么，下行回报什么，谁能叫停。本 schema 是该制度的机读形式，用于让 run_twoway_tabletop.js 对运行图逐条判定。它描述的是方案建议的准入契约，不是已获批准的行政程序。",
  "type": "object",
  "additionalProperties": false,
  "required": ["service_id", "name_zh", "node", "operator", "uplink", "downlink", "review_and_exit", "privacy", "non_ai_fallback", "status"],
  "properties": {
    "service_id": {
      "type": "string",
      "pattern": "^[TS][0-9]{1,2}$",
      "description": "班次号。T 字头为产业测试验证场景，S 字头为常规服务班次。"
    },
    "name_zh": { "type": "string", "minLength": 2 },
    "name_en": { "type": "string" },
    "node": {
      "type": "string",
      "minLength": 2,
      "description": "三要素之一·节点（空间）。缺失即不得排图。"
    },
    "operator": {
      "type": "string",
      "minLength": 2,
      "description": "三要素之一·运营主体（运营）。缺失即不得排图。"
    },
    "uplink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["takes", "data_classes"],
      "description": "三要素之一·上行清单：这次部署从公共侧取走什么。",
      "properties": {
        "takes": { "type": "string", "minLength": 2 },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["anonymous_aggregate", "desensitized_operational", "voluntary_consented", "authorized_business", "environmental_sensor", "public_registry"]
          },
          "description": "只允许这六类。人脸识别布控与可识别个体轨迹不在其列，故无法通过 schema 表达。"
        }
      }
    },
    "downlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returns", "beneficiary", "public_commitment"],
      "description": "三要素之一·下行清单：与上行成对出现的公共回报。禁止只取不还。",
      "properties": {
        "returns": { "type": "string", "minLength": 2 },
        "beneficiary": { "type": "string", "minLength": 2 },
        "public_commitment": {
          "type": "string",
          "minLength": 2,
          "description": "可被公众核对的承诺形式（公示、开放、免费额度等）。"
        }
      }
    },
    "review_and_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "who_can_halt"],
      "properties": {
        "mechanism": { "type": "string", "minLength": 2 },
        "who_can_halt": { "type": "string", "minLength": 2, "description": "「谁能叫停」必须有确定主体。" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face_recognition_surveillance", "identifiable_trajectory"],
      "properties": {
        "face_recognition_surveillance": { "const": false, "description": "方案自设红线：不做人脸识别布控。" },
        "identifiable_trajectory": { "const": false, "description": "方案自设红线：不采集可识别个体轨迹。" },
        "human_review": { "type": "string" }
      }
    },
    "non_ai_fallback": {
      "type": "string",
      "minLength": 2,
      "description": "每个班次必须有非 AI 等价服务路径。"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "scheduled", "halted"],
      "description": "运行图状态。测试班次（T 字头）不得写成已批准运营，故不设 approved/operating 取值。"
    }
  }
}
