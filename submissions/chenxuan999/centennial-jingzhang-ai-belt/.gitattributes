# Force LF checkout for text assets so recorded sha256 in manifest.json
# matches what the CI validator computes on the runner (no CRLF skew).
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.geojson text eol=lf
*.svg text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
