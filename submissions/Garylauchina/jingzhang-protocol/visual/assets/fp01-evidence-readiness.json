    "readiness_status": "pending_external_evidence",
    "verified_gate_count": 0,
    "gate_count": 5,
    "authorization_status": "not_authorized",
    "fieldwork_status": "not_conducted",
    "operator_confirmation_status": "unconfirmed",
    "budget_status": "unknown",
    "procurement_status": "not_procured",
    "professional_review_status": "not_conducted",
    "rehearsal_status": "not_conducted",
    "outcome_status": "unknown",
    "scope_note_zh": "本文件只把 H0—H4 所需外部证据转化为可填写、可核验、可停止的登记结构。当前没有把现场调研、实名主体、预算采购、专业审查、试运行或结果写成已发生事实。",
    "scope_note_en": "This file only turns the external evidence required by H0-H4 into a fillable, checkable, and stoppable register. It does not represent fieldwork, named entities, budgets, procurement, professional review, rehearsals, or outcomes as completed facts."
  },
  "advancement_rule": {
    "sequence": [
      "H0",
      "H1",
      "H2",
      "H3",
      "H4"
    ],
    "default_state": "pending_external_evidence",
    "gate_pass_rule": "all_required_evidence_items_independently_verifiable_and_gate_decision_cosigned",
    "failed_or_missing_rule": "stop_and_remain_concept_only",
    "no_self_certification": true,
    "no_structural_pass_as_delivery_claim": true,
    "separate_authorization_after_h3": true,
    "rule_zh": "后一门不得绕过前一门；材料齐全也不自动等于通过。每一门须由相应责任角色签认，H3 评测须与供应、运营或采购决定分离，H4 授权须与设计审查或测试通过分离。",
    "rule_en": "No later gate may bypass an earlier gate, and document completeness does not automatically mean passage. Each gate requires sign-off by the relevant accountable roles; H3 evaluation must be separated from supply, operations, or procurement, and H4 authorization must be separate from design review or test passage."
  },
