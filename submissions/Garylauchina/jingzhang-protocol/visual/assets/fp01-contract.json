    "mobility_mode_status": "synthetic_accessibility_design_test_condition",
    "situation_zh": "正在探索一次学习或职业方向调整，希望先了解可用的课程、辅导或公共职业服务，但不希望被迫安装应用、注册 AI 账户或接受自动资格判断。",
    "situation_en": "Exploring an early-career learning or work transition and seeking available courses, mentoring, or public career services without being forced to install an app, create an AI account, or accept an automated eligibility decision.",
    "design_needs": [
      "walk_in_or_staffed_access",
      "no_smartphone_required",
      "non_ai_catalogue_available",
      "plain_language_explanation",
      "human_confirmation_before_referral",
      "appeal_route",
      "deletion_route",
      "exit_and_baseline_restoration"
