  "service_journey": [
    {
      "step_id": "J01",
      "stage": "arrive",
      "action_zh": "使用者凭现场标识进入人工服务台；无需智能手机、应用或 AI 账户。",
      "action_en": "The user follows on-site signs to a staffed desk; no smartphone, app, or AI account is required.",
      "human_or_non_ai_control": "staffed_walk_in_desk"
    },
    {
      "step_id": "J02",
      "stage": "choose_channel",
      "action_zh": "使用者选择普通目录与人工咨询，或自愿选择 AI 辅助；拒绝 AI 不影响服务等级。",
      "action_en": "The user chooses the ordinary catalogue and human consultation or opts into AI assistance; declining AI does not reduce service access.",
      "human_or_non_ai_control": "paper_or_staffed_non_ai_catalogue"
    },
    {
      "step_id": "J03",
      "stage": "state_minimum_need",
      "action_zh": "只记录完成服务所需的目标类别、可达性选择和服务范围，不采集直接身份信息或原始自由文本。",
      "action_en": "Only the goal category, accessibility choice, and service scope needed to complete the task are recorded; no direct identifiers or raw free text are collected.",
      "human_or_non_ai_control": "minimum_necessary_staffed_intake"
    },
    {
      "step_id": "J04",
      "stage": "compare_catalogue",
      "action_zh": "普通目录始终可见；AI 可以生成候选解释，但不得决定录取、就业、资格或人员排序。",
      "action_en": "The ordinary catalogue remains visible; AI may explain candidate services but cannot decide admission, employment, eligibility, or ranking of people.",
      "human_or_non_ai_control": "ordinary_catalogue_is_source_of_continuity"
    },
    {
      "step_id": "J05",
      "stage": "human_confirmation",
      "action_zh": "服务专业人员核对服务范围、公开条件和使用者陈述的目标，人工确认一项转介或给出有理由的拒绝。",
      "action_en": "A service professional checks the service scope, published conditions, and user-stated goal, then confirms one referral or issues a reasoned refusal.",
      "human_or_non_ai_control": "named_human_confirmation_required"
    },
    {
      "step_id": "J06",
      "stage": "issue_receipt",
      "action_zh": "向使用者提供纸质或可携带回执，写明结果、人工责任、AI 是否参与、理由码、申诉、删除和退出路径。",
      "action_en": "The user receives a paper or portable receipt stating the outcome, human accountability, whether AI assisted, reason code, and appeal, deletion, and exit routes.",
      "human_or_non_ai_control": "paper_or_portable_receipt"
    },
    {
      "step_id": "J07",
      "stage": "appeal_delete_or_exit",
      "action_zh": "使用者可由人工处理申诉、提出删除请求或退出 AI 辅助；退出后恢复普通目录与人工服务，不得降低原有服务。",
      "action_en": "The user may seek a human-handled appeal, request deletion, or leave AI assistance; exit restores the ordinary catalogue and human service without degrading the prior service.",
      "human_or_non_ai_control": "human_appeal_and_baseline_restoration"
    }
  ],
