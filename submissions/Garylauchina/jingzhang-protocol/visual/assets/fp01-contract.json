  "service_problem": {
    "problem_id": "FP01-S07-PROBLEM-001",
    "status": "design_question_not_field_verified",
    "question_zh": "一位早期职业阶段使用者能否在协议零号站，不依赖智能手机或 AI-only 路径，找到并经人工确认一项合适的学习或职业服务，并拿到可申诉、可删除、可退出的回执？",
    "question_en": "Can an early-career user at Protocol Station Zero find one suitable learning or career service, have it confirmed by a person, and receive an appealable, deletable, and exit-enabled receipt without depending on a smartphone or an AI-only path?",
    "user_outcome_zh": "找到一项由人工确认的合适服务，或得到有理由、可申诉且不降低原有人工服务可达性的拒绝；两种结果都附带删除与退出权利。",
    "user_outcome_en": "Receive either one human-confirmed suitable service or a reasoned and appealable refusal that does not reduce access to the prior human service; both outcomes carry deletion and exit rights.",
    "service_scope": "learning_or_career_service_discovery_and_human_confirmed_referral",
    "excluded_decisions": [
      "admission_eligibility",
      "employment_eligibility",
      "hiring_or_rejection",
      "benefit_eligibility",
      "credential_award",
      "automated_ranking_of_people"
    ],
    "success_definition_status": "proposed_not_measured"
  },
