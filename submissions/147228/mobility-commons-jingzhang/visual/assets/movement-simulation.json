{
  "version": "1.1",
  "simulation_class": "illustrative_design_scenario_not_local_baseline",
  "status": "transparent_sandbox_before_field_calibration",
  "purpose": "Compare operating logic and expose trade-offs before real counts; never report these values as current Haidian performance.",
  "time_window": "weekday_am_peak_design_window_07:30-09:30",
  "demand_units": 1000,
  "input_basis": {
    "mode_groups": [
      "metro",
      "bus",
      "bicycle",
      "walking",
      "wheelchair",
      "car",
      "enterprise_shuttle"
    ],
    "people_groups": [
      "enterprise_employee",
      "resident",
      "carer",
      "child",
      "wheelchair_user",
      "visitor",
      "logistics",
      "night_worker"
    ],
    "external_commute": "cross_boundary_OD_is_included",
    "assumption_note": "Demand is a normalized 1000-person design unit with no local count claim; replace with dated grouped OD and field observations."
  },
  "score_formula": "efficiency_index is a 0-100 illustrative weighted comparison after hard-gate screening: cost 30%, transfer 20%, people-flow 20%, external-car reduction 15%, worst-group equity 15%.",
  "hard_gates": [
    "fire_emergency",
    "accessibility_continuity",
    "public_transport_protection",
    "privacy",
    "human_service"
  ],
